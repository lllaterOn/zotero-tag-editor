{
  "manifest_version": 2,
  "name": "Zotero Tag Editor",
  "version": "1.0.1",
  "description": "批量添加、移除或重命名所选文献条目的标签。",
  "author": "lllaterOn",
  "homepage_url": "https://github.com/lllaterOn/zotero-tag-editor",
  "icons": {
    "48": "content/tag.svg",
    "96": "content/tag.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-tag-editor@lllateron",
      "strict_min_version": "10.0.3",
      "strict_max_version": "10.*",
      "update_url": "https://raw.githubusercontent.com/lllaterOn/zotero-tag-editor/main/updates.json"
    },
    "gecko": {
      "id": "zotero-tag-editor@lllateron"
    }
  }
}
